{
  "name": "orchids-theme",
  "displayName": "Orchids",
  "description": "A light & dark color theme for VS Code — every hue sampled from five living orchid species.",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.0.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "orchids",
    "light",
    "dark",
    "pastel",
    "nature",
    "orchid"
