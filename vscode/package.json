      "description": "Orchids Dark theme"
    },
    {
      "theme": "Orchids Light",
      "path": "screenshots/light.png",
      "description": "Orchids Light theme"
    }
  ],
  "contributes": {
    "themes": [
      {
        "label": "Orchids Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/orchids-dark-color-theme.json"
      },
      {
        "label": "Orchids Light",
        "uiTheme": "vs",
        "path": "./themes/orchids-light-color-theme.json"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/orchids-vscode"
  },
  "bugs": {
    "url": "https://github.com/your-username/orchids-vscode/issues"
